{#-
    Head of My account: title and tabs, one address each (works without JavaScript). Profile, sign-in and security,
    accounts, properties, budget household and categories, Carbure, AI agents (when the API or the MCP is enabled).
    The sign-in log is at the end of the sign-in and security tab. The current tab comes from the path (NavigationExtension).
-#}
{%- set account_tab_current = account_tab(app.request.pathInfo) -%}
{%- set account_tab_items = [
    {tab: 'profile', route: 'app_security', label: 'Profil'|trans, icon: 'user'},
    {tab: 'sign_in', route: 'app_security_signin', label: 'Connexion et sécurité'|trans, icon: 'lock'},
    {tab: 'accounts', route: 'app_accounts', label: 'Comptes'|trans, icon: 'accounts'},
    {tab: 'properties', route: 'app_properties', label: 'Biens immobiliers'|trans, icon: 'property'},
    {tab: 'budget', route: 'app_budget_household', label: 'Foyer fiscal et catégories'|trans, icon: 'budget'},
    {tab: 'carbure', route: 'app_budget_carbure', label: 'Carbure'|trans, icon: 'carbure'},
]|merge(api_access_available() ? [{tab: 'agents', route: 'app_security_agents', label: 'Agents IA'|trans, icon: 'agents'}] : []) -%}
<div class="page-head">
    <h1>{{ 'Mon compte'|trans }}</h1>
</div>
<nav class="account-tabs" aria-label="{{ 'Sections de Mon compte'|trans }}">
    {#- A demonstration account only sees the tabs it may use (DemoGuard). -#}
    {% for account_tab_item in account_tab_items|filter(item => demo_allows(item.route)) %}
    <a href="{{ path(account_tab_item.route) }}"{% if account_tab_item.tab == account_tab_current %} aria-current="{{ path(account_tab_item.route) == app.request.pathInfo ? 'page' : 'true' }}"{% endif %}>
        {{ icon(account_tab_item.icon) }}
        <span>{{ account_tab_item.label }}</span>
    </a>
    {% endfor %}
</nav>
