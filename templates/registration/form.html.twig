{% extends 'base.html.twig' %}

{% block title %}{{ 'Créer un compte'|trans }}{% endblock %}

{% block body %}
{% import '_form_macros.html.twig' as f %}
<section class="card login-card">
    <h1>{{ 'Créer un compte'|trans }}</h1>
    {% if not open %}
    <p class="flash flash-error" role="alert">{{ 'Les inscriptions sont fermées sur ce serveur. Demandez un compte à son administrateur.'|trans }}</p>
    {% else %}
    <form method="post" action="{{ path('app_register_submit') }}" class="form" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">

        <div class="field">
            <label for="email">{{ 'Adresse e-mail'|trans }}</label>
            <input type="email" id="email" name="email" value="{{ email }}" autocomplete="email" maxlength="254" required autofocus
                   {{- f.described(errors, 'email', allowed_domains is not empty ? 'email-hint' : null) }}>
            {% if allowed_domains is not empty %}
            <p class="hint" id="email-hint">{{ 'Adresses acceptées : %domains%.'|trans({'%domains%': allowed_domains|map(d => '@' ~ d)|join(', ')}) }}</p>
            {% endif %}
            {{ f.error(errors, 'email') }}
        </div>

        <div class="field">
            <label for="password">{{ 'Mot de passe'|trans }}</label>
            <input type="password" id="password" name="password" autocomplete="new-password" minlength="{{ min_length }}" required
                   {{- f.described(errors, 'password', 'password-meter') }}>
            {{ f.error(errors, 'password') }}
            {{ include('_password_meter.html.twig', {input_id: 'password', confirm_id: 'password_confirmation', email_input_id: 'email', min_length: min_length}) }}
        </div>

        <div class="field">
            <label for="password_confirmation">{{ 'Confirmation du mot de passe'|trans }}</label>
            <input type="password" id="password_confirmation" name="password_confirmation" autocomplete="new-password" required
                   {{- f.described(errors, 'password_confirmation', null) }}>
            {{ f.error(errors, 'password_confirmation') }}
        </div>

        <button type="submit" class="btn btn-primary btn-block">{{ 'Créer mon compte'|trans }}</button>
    </form>
    <p class="hint">{{ 'Vous recevrez un lien de confirmation par e-mail, puis vous configurerez une application d\'authentification (TOTP), obligatoire.'|trans }}</p>
    {% endif %}
    <p class="login-alt">{{ 'Déjà un compte ?'|trans }} <a href="{{ path('app_login') }}">{{ 'Se connecter'|trans }}</a></p>
</section>
{% endblock %}
