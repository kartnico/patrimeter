{#- A challenge card (ChallengeCard): its stars (the best ever reached, out of the most it gives), the rail of its
    thresholds from the first to the last, where it stands this month, what is missing for the next star and its rule;
    the savings rate challenge also takes the rate the user aims at (savings_rates, savings_rate_target). -#}
{%- set card_result = card.result -%}
{%- set card_challenge = card.result.challenge -%}
{%- set card_title = card_challenge.title|trans -%}
<li class="card challenge medal{{ card.complete ? ' is-complete' }}">
    <div class="medal-top">
        <span class="challenge-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="{{ card_challenge.icon }}"/></svg></span>
        <div>
            <h3>{{ card_title }}</h3>
            <span class="medal-score">{{ '%count% étoile acquise sur %total%|%count% étoiles acquises sur %total%'|trans({'%count%': card.stars, '%total%': card_result.maxStars}) }}</span>
        </div>
    </div>
    {#- The thresholds from the first to the last: short name under each star for the eye, full sentence and state for
        screen readers (never the colour alone). -#}
    <ol class="rail" aria-label="{{ 'Paliers du défi « %challenge% »'|trans({'%challenge%': card_title}) }}">
        {% for card_step in card.steps %}
        {%- set card_step_parameters = card_result.parameters|merge({'%count%': card_step.threshold}) -%}
        <li class="{{ card_step.state }}">
            <svg aria-hidden="true" viewBox="0 0 32 32"><path d="m16 3 3.9 8 8.8 1.3-6.4 6.2 1.5 8.8L16 23.1l-7.8 4.2 1.5-8.8-6.4-6.2 8.8-1.3Z"/></svg>
            <b aria-hidden="true">{{ card_challenge.stepLabel|trans(card_step_parameters) }}</b>
            <span class="visually-hidden">{{ card_challenge.thresholdLabel|trans(card_step_parameters) }}</span>
            <small>{% if card_step.state == 'earned' %}{{ 'Acquise'|trans }}{% elseif card_step.state == 'next' %}{{ 'Suivante'|trans }}{% else %}{{ 'À venir'|trans }}{% endif %}</small>
        </li>
        {% endfor %}
    </ol>
    {% if card_result.available %}
    <div class="fact">
        <b>{{ card_result.value > 0 ? 'Déjà fait'|trans : 'Situation actuelle'|trans }}</b>
        <p class="challenge-progress">{{ card_challenge.progressLabel|trans(card_result.messageParameters) }}</p>
    </div>
    {% endif %}
    {% if card.complete %}
    <div class="delta finished">
        <b><span aria-hidden="true">✓</span> {{ 'Défi réussi'|trans }}</b>
        <p>{{ 'Toutes les étoiles de ce défi sont acquises.'|trans }}</p>
    </div>
    {% elseif not card_result.available %}
    <div class="delta">
        <b>{{ 'Avant de commencer'|trans }}</b>
        <p>{{ card_challenge.unavailableLabel|trans }}</p>
    </div>
    {% else %}
    <div class="delta">
        <b>{{ card.nextStarLabel|trans }}</b>
        <p>{{ card_challenge.missingLabel|trans(card.missingParameters) }}</p>
        {% if card.remainingSteps is not empty %}
        <ul class="delta-steps">
            {% for card_first_step in card.remainingSteps %}<li>{{ card_first_step.label|trans }}</li>{% endfor %}
        </ul>
        {% endif %}
    </div>
    {% endif %}
    {% if card_challenge.value == 'savings_rate' %}
    <form method="post" action="{{ path('app_challenges_settings') }}" class="challenge-setting">
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        <input type="hidden" name="action" value="savings_rate">
        <input type="hidden" name="_return" value="{{ path('app_challenges') }}">
        <label for="savings-rate">{{ 'Taux d\'épargne que vous visez'|trans }}</label>
        <select id="savings-rate" name="taux">
            <option value="">{{ 'Aucun'|trans }}</option>
            {% for rate in savings_rates %}
            <option value="{{ rate }}"{% if rate == savings_rate_target %} selected{% endif %}>{{ rate }} %</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn btn-small">{{ 'Enregistrer'|trans }}</button>
    </form>
    {% endif %}
    <details>
        <summary>{{ 'Règle du défi'|trans }}</summary>
        <p class="muted small">{{ card_challenge.description|trans }}</p>
    </details>
</li>
