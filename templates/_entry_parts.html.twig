{#-
    The parts of the monthly entry: wealth (balances of the accounts) and budget, for the same month, and the savings
    goals. Variable: month (Month).
-#}
{%- set entry_part_items = [
    {route: 'app_entry', label: 'Patrimoine'|trans, icon: 'home', month: true},
    {route: 'app_budget_entry', label: 'Budget'|trans, icon: 'budget', month: true},
    {route: 'app_goal_entry', label: 'Objectifs'|trans, icon: 'goal', month: false},
] -%}
<nav class="account-tabs entry-parts" aria-label="{{ 'Parties de la saisie du mois'|trans }}">
    {% for entry_part_item in entry_part_items %}
    <a href="{{ entry_part_item.month ? path(entry_part_item.route, {mois: month.toString}) : path(entry_part_item.route) }}"{% if path(entry_part_item.route) == app.request.pathInfo %} aria-current="page"{% endif %}>
        {{ icon(entry_part_item.icon) }}
        <span>{{ entry_part_item.label }}</span>
    </a>
    {% endfor %}
</nav>
