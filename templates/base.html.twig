{#- Shared layout: header, navigation, messages and content. No inline script or style (CSP). -#}
{#- Main navigation: wealth, budget, savings goals, challenges (if on), then the monthly entry, last and always put
    forward. Accounts and properties open from the wealth page, the tax household from the budget page; the other
    settings live in My account (NavigationExtension). -#}
{%- set nav = [
    {section: 'wealth', href: path('app_dashboard'), label: 'Patrimoine'|trans, short: 'Patrimoine'|trans, icon: 'M3 11 12 3l9 8v10h-6v-6H9v6H3z'},
    {section: 'budget', href: path('app_budget'), label: 'Budget'|trans, short: 'Budget'|trans, icon: 'M21.2 15.9A10 10 0 1 1 8 2.8M22 12A10 10 0 0 0 12 2v10z'},
    {section: 'goals', href: path('app_goals'), label: 'Objectifs'|trans, short: 'Objectifs'|trans, icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM12 12h.01'},
    {section: 'entry', href: path('app_entry'), label: 'Saisie du mois'|trans, short: 'Saisie'|trans, icon: 'M4 20h4L19 9l-4-4L4 16zM14 6l4 4'},
] -%}
{#- Challenges and stars, when the instance and the user keep them on (GameExtension). -#}
{%- if account_ready() and game_enabled() -%}
{%- set nav = nav|merge([{section: 'challenges', href: path('app_challenges'), label: 'Défis'|trans, short: 'Défis'|trans, icon: 'M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8L3.5 9.7l5.9-.9z'}]) -%}
{%- endif -%}
{%- set current_path = app.request.pathInfo -%}
{%- set current_section = nav_section(current_path) -%}
{%- set theme = theme_preference(app.request) -%}
{%- set ready = account_ready() -%}
<!doctype html>
<html lang="{{ app.request.locale }}"{% if theme %} data-theme="{{ theme }}"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="theme-color" content="#2f6f5e">
<meta name="robots" content="noindex, nofollow">
<title>{% block title %}Patrimeter{% endblock %} · Patrimeter</title>
<link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
<script src="{{ asset('js/app.js') }}" defer></script>
{% block scripts %}{% endblock %}
{% block head_extra %}{% endblock %}
</head>
<body class="{{ ready ? 'is-auth' : 'is-guest' }}{% block body_class %}{% endblock %}">
{% block topbar %}
<header class="topbar">
    <a class="brand" href="{{ path('app_dashboard') }}" aria-label="{{ 'Patrimeter, patrimoine'|trans }}">
        <svg class="brand-logo" viewBox="0 0 32 32" aria-hidden="true"><path class="brand-logo-base" d="M16 3 30 28H2z"/><path class="brand-logo-tip" d="M16 3 21.6 13H10.4z"/></svg>
        <span>Patrimeter</span>
    </a>
    {% if ready %}
    <nav class="nav" aria-label="{{ 'Navigation principale'|trans }}">
        {%- set layout_entry_due = entry_due() -%}
        {% for item in nav|filter(nav_item => nav_item.section != 'entry') %}
        {{ include('_nav_item.html.twig', {item: item, current_section: current_section, current_path: current_path, due: false}, with_context = false) }}
        {% endfor %}
        {#- Monthly entry: last, on the right of every entry. -#}
        {% for item in nav|filter(nav_item => nav_item.section == 'entry') %}
        {{ include('_nav_item.html.twig', {item: item, current_section: current_section, current_path: current_path, due: layout_entry_due}, with_context = false) }}
        {% endfor %}
    </nav>
    {% endif %}
    {% if ready %}
    {#- Current month, in the middle of the top bar: in full on a computer, short on a phone; a link back to it, on the
        same page when it shows a month. -#}
    {%- set topbar_month = current_month() -%}
    <p class="topbar-month"><a href="{{ current_month_path(app.request.pathInfo, topbar_month.toString) }}" title="{{ 'Revenir au mois en cours'|trans }}"><time datetime="{{ topbar_month.toString }}"><span class="visually-hidden">{{ 'Mois en cours :'|trans }} </span><span class="topbar-month-long">{{ topbar_month|month_label|capitalize }}</span><span class="topbar-month-short">{{ topbar_month|month_short|capitalize }}</span></time></a></p>
    {% endif %}
    {#- Light / dark switch: a form without JavaScript, instant switch with it (app.js). -#}
    <form class="theme-form" method="post" action="{{ path('app_theme') }}" data-theme-toggle data-theme-cookie="patrimeter_theme">
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        <input type="hidden" name="_return" value="{{ app.request.requestUri }}">
        <button type="submit" name="theme" value="toggle" class="theme-toggle" title="{{ 'Basculer entre thème clair et sombre'|trans }}">
            <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
            <span class="visually-hidden">{{ 'Basculer entre thème clair et sombre'|trans }}</span>
        </button>
    </form>
    {#-
        Interface language: the current language, and on click a menu of languages, each named in its own language
        (LocaleController). A <details> menu: works without JavaScript; app.js closes it on an outside click.
    -#}
    {%- set site_languages = {fr: 'Français', en: 'English'} -%}
    <details class="locale-menu" data-locale-menu>
        <summary class="locale-toggle" title="{{ 'Langue du site'|trans }}">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>
            <span aria-hidden="true">{{ app.request.locale|upper }}</span>
            <span class="visually-hidden">{{ 'Langue du site : %language%'|trans({'%language%': site_languages[app.request.locale] ?? app.request.locale}) }}</span>
            <span class="caret" aria-hidden="true">▾</span>
        </summary>
        <form class="locale-form" method="post" action="{{ path('app_locale') }}">
            <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
            <input type="hidden" name="_return" value="{{ app.request.requestUri }}">
            {% for code, language_name in site_languages %}
            <button type="submit" name="locale" value="{{ code }}" lang="{{ code }}"{% if code == app.request.locale %} aria-current="true"{% endif %}>{{ language_name }}{% if code == app.request.locale %}<span aria-hidden="true">✓</span>{% endif %}</button>
            {% endfor %}
        </form>
    </details>
    {% if app.user %}
    {#-
        Account menu: profile, AI agents (when the API or the MCP is enabled) and sign out. A <details> menu like the
        language one: works without JavaScript; app.js closes it on an outside click or with Escape.
    -#}
    <details class="account-menu" data-dropdown>
        <summary class="account-toggle"{% if current_section == 'account' %} data-current{% endif %}>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0"/></svg>
            <span class="account-label">{{ 'Mon compte'|trans }}</span>
            <span class="caret" aria-hidden="true">▾</span>
        </summary>
        <div class="account-items">
            {% if ready and not demo_allows('app_security') %}
            {#- Demonstration account: its accounts, properties, household and categories instead of the profile. -#}
            <a href="{{ path('app_accounts') }}"{% if current_path == '/comptes' %} aria-current="page"{% endif %}>
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>{{ 'Comptes'|trans }}
            </a>
            <a href="{{ path('app_properties') }}"{% if current_path == '/biens' %} aria-current="page"{% endif %}>
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V8l8-5 8 5v13M4 21h16M9 21v-6h6v6"/></svg>{{ 'Biens immobiliers'|trans }}
            </a>
            <a href="{{ path('app_budget_household') }}"{% if current_path == '/budget/foyer' %} aria-current="page"{% endif %}>
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.2 15.9A10 10 0 1 1 8 2.8M22 12A10 10 0 0 0 12 2v10z"/></svg>{{ 'Foyer fiscal et catégories'|trans }}
            </a>
            {% elseif ready %}
            <a href="{{ path('app_security') }}"{% if current_path == '/securite' %} aria-current="page"{% endif %}>
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0"/></svg>{{ 'Mon profil'|trans }}
            </a>
            {% if api_access_available() %}
            <a href="{{ path('app_security_agents') }}"{% if current_path == '/securite/agents-ia' %} aria-current="page"{% endif %}>
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9h14v11H5zM12 9V6M12 3v1M9 14v1M15 14v1M2 13v3M22 13v3"/></svg>{{ 'Agents IA'|trans }}
            </a>
            {% endif %}
            {% endif %}
            {%- set layout_documentation = documentation_url() -%}
            {% if layout_documentation is not null %}
            <a href="{{ layout_documentation }}" rel="help">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2zM4 21V5M8 7h7M8 11h7"/></svg>{{ 'Documentation'|trans }}
            </a>
            {% endif %}
            <form method="post" action="{{ path('app_logout') }}">
                <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
                <button type="submit">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10"/></svg>{{ 'Déconnexion'|trans }}
                </button>
            </form>
        </div>
    </details>
    {% endif %}
</header>
{% endblock %}
<main class="main" id="contenu">
{%- set layout_demo_end = demo_end_time() -%}
{%- set layout_tour = demo_tour() -%}
{% if layout_demo_end is not null %}
<div class="demo-banner">
    <p><strong>{{ 'Démonstration'|trans }}</strong> · {{ 'Données fictives, compte supprimé à %time% ou à la déconnexion. N\'y saisissez aucune donnée réelle.'|trans({'%time%': layout_demo_end}) }}</p>
    {#- Guided tour: started again when stopped, resumed from another page than its step's. -#}
    {% if layout_tour is not null and not layout_tour.here %}
    <form method="post" action="{{ path('app_demo_tour') }}">
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        {% if layout_tour.active %}
        <button type="submit" name="action" value="resume" class="btn btn-small">{{ 'Reprendre la visite guidée (étape %number% sur %total%)'|trans({'%number%': layout_tour.number, '%total%': layout_tour.total}) }}</button>
        {% else %}
        <button type="submit" name="action" value="start" class="btn btn-small">{{ 'Lancer la visite guidée'|trans }}</button>
        {% endif %}
    </form>
    {% endif %}
</div>
{% endif %}
{% for type, messages in app.flashes %}
{% for message in messages %}
    <p class="flash flash-{{ type }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message|trans }}</p>
{% endfor %}
{% endfor %}
{% block body %}{% endblock %}
{% if layout_tour is not null and layout_tour.here %}{% include '_demo_tour.html.twig' with {tour: layout_tour} only %}{% endif %}
<footer class="app-footer"><p><a href="{{ app_project_url() }}">Patrimeter</a> © {{ app_copyright_years() }} · <a href="{{ app_license_url() }}">{{ 'Logiciel libre sous licence MIT'|trans }}</a>{% if app_version_visible() %}<span class="app-version"> · {{ 'version %version%'|trans({'%version%': app_version()}) }}</span>{% endif %}</p></footer>
</main>
</body>
</html>
