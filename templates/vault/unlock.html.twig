{% extends 'base.html.twig' %}

{% block title %}{{ 'Déverrouiller'|trans }}{% endblock %}

{% block body %}
<section class="card login-card">
    <h1>{{ 'Déverrouiller vos données'|trans }}</h1>
    <p>{{ 'Vos données sont chiffrées. Saisissez votre mot de passe pour y accéder.'|trans }}</p>
    {% if error %}
    <p class="flash flash-error" role="alert">{{ error|trans }}</p>
    {% endif %}
    <form method="post" action="{{ path('app_vault_unlock_submit') }}" class="form">
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        <label for="password">{{ 'Mot de passe'|trans }}</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required autofocus>
        <button type="submit" class="btn btn-primary btn-block">{{ 'Déverrouiller'|trans }}</button>
    </form>
</section>
{% endblock %}
