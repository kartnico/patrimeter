{% extends 'base.html.twig' %}

{% block title %}{{ 'Membres de la famille'|trans }}{% endblock %}

{% block body %}
{% import '_advice.html.twig' as advice_ui %}
<div class="page-head">
    <h1>{{ 'Membres de la famille'|trans }}</h1>
    {% if members is not empty %}
    <a class="btn btn-small" href="{{ path('app_dashboard', {perimetre: 'famille'}) }}">{{ 'Voir la famille'|trans }}</a>
    {% endif %}
</div>
<p class="sheet-lead">{{ 'Un compte famille réunit les données de deux personnes, saisies chacune dans son propre compte. Chaque mois, chacune exporte ses données ; ce compte importe son fichier, qui remplace le précédent. Les pages Patrimoine et Budget montrent alors la famille, ou chacun.'|trans }}</p>

{% for item in members %}
{%- set member = item.member -%}
<section class="sheet family-member" aria-labelledby="member-{{ member.id }}">
    <h2 id="member-{{ member.id }}">{{ member.name }}</h2>
    <dl class="wealth-tiles">
        <div class="wealth-tile">
            <dt>{{ 'Patrimoine net'|trans }}</dt>
            <dd>
                <a class="wealth-tile-value num" href="{{ path('app_dashboard', {perimetre: 'membre-' ~ member.id}) }}">{{ item.net is null ? '—' : item.net|money }}</a>
                <span class="wealth-tile-sub">{{ current_month|month_label|capitalize }}</span>
            </dd>
        </div>
        <div class="wealth-tile">
            <dt>{{ 'Comptes'|trans }}</dt>
            <dd>
                <span class="wealth-tile-value num">{{ item.accounts }}</span>
                <span class="wealth-tile-sub">{{ item.budget ? 'avec son budget'|trans : 'sans budget'|trans }}</span>
            </dd>
        </div>
        <div class="wealth-tile">
            <dt>{{ 'Dernier import'|trans }}</dt>
            <dd>
                <span class="wealth-tile-value">{{ member.importedOn|date_fr }}</span>
                <span class="wealth-tile-sub">{{ member.exportedOn ? 'fichier du %date%'|trans({'%date%': member.exportedOn|date_fr}) : 'date du fichier inconnue'|trans }}</span>
            </dd>
        </div>
    </dl>
    {% if item.stale %}
    <p class="advice is-warning">{{ advice_ui.tag('warning') }}
        {{ 'Ce fichier date d\'avant %month% : importez celui du mois pour une vue à jour.'|trans({'%month%': current_month|month_label}) }}</p>
    {% endif %}
    <form method="post" action="{{ path('app_family_member_update', {id: member.id}) }}" enctype="multipart/form-data" class="form family-import">
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        <label for="fichier-{{ member.id }}">{{ 'Nouveau fichier d\'export de %name% (JSON, 2 Mo au plus)'|trans({'%name%': member.name}) }}</label>
        <input type="file" id="fichier-{{ member.id }}" name="fichier" accept="application/json,.json" required>
        <p class="actions"><button type="submit" class="btn btn-primary">{{ 'Mettre à jour'|trans }}</button></p>
    </form>
    <form method="post" action="{{ path('app_family_member_delete', {id: member.id}) }}"
          data-confirm="{{ 'Retirer %name% de la famille ? Ses données importées sont supprimées de ce compte (pas de son propre compte).'|trans({'%name%': member.name}) }}">
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        <button type="submit" class="btn btn-danger btn-small">{{ 'Retirer %name%'|trans({'%name%': member.name}) }}</button>
    </form>
</section>
{% endfor %}

{% if can_add %}
<section class="sheet" aria-labelledby="member-new-title">
    <h2 id="member-new-title">{{ 'Ajouter un membre'|trans }}</h2>
    <form method="post" action="{{ path('app_family_member_add') }}" enctype="multipart/form-data" class="form">
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        <div class="field">
            <label for="member-name">{{ 'Nom'|trans }}</label>
            <input type="text" id="member-name" name="name" maxlength="40" required autocomplete="off" placeholder="{{ 'ex. Alex'|trans }}">
        </div>
        <div class="field">
            <label for="fichier">{{ 'Son fichier d\'export (JSON, 2 Mo au plus)'|trans }}</label>
            <input type="file" id="fichier" name="fichier" accept="application/json,.json" required>
        </div>
        <p class="actions"><button type="submit" class="btn btn-primary">{{ 'Importer'|trans }}</button></p>
    </form>
</section>
{% endif %}

<section class="sheet" aria-labelledby="family-how-title">
    <h2 id="family-how-title">{{ 'Comment ça marche'|trans }}</h2>
    <ol class="family-steps">
        <li>{{ 'Chacun crée son propre compte Patrimeter, y saisit ses comptes, ses soldes et son budget.'|trans }}</li>
        <li>{{ 'Ce qui est commun se partage : chacun saisit sa part (la moitié du compte joint, sa quote-part de la maison, sa part du loyer et des courses). La famille additionne, sans rien compter deux fois.'|trans }}</li>
        <li>{{ 'Chaque mois, chacun télécharge ses données depuis « Vos données » de son compte.'|trans }}</li>
        <li>{{ 'Ce compte importe chaque fichier pour son membre : les données importées sont chiffrées avec la clé de ce compte, en lecture seule.'|trans }}</li>
    </ol>
    <p class="muted small">{{ 'Ce compte peut aussi avoir ses propres comptes (par exemple ceux des enfants) : ils comptent dans la famille. L\'export de ce compte ne contient que ses propres données.'|trans }}</p>
</section>
{% endblock %}
