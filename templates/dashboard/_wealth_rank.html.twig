{#- Position of the net worth among French households (Patrimeter\Domain\WealthDistribution). -#}
<section class="card wealth-rank" aria-labelledby="wealth-rank-title">
    <h2 id="wealth-rank-title" class="wealth-rank-title">{{ 'Parmi les ménages français'|trans }}</h2>
    {% if rank.topPercent %}
    <p class="wealth-rank-main">{{ 'Vous faites partie du %share% des ménages les mieux dotés.'|trans({'%share%': '<strong class="num">' ~ 1|percent(0) ~ '</strong>'})|raw }}</p>
    {% else %}
    <p class="wealth-rank-main">{{ 'Votre patrimoine net dépasse celui d\'environ %share% des ménages.'|trans({'%share%': '<strong class="num">' ~ rank.percent|percent(0) ~ '</strong>'})|raw }}</p>
    {% endif %}
    <p class="muted small">{{ rank.decile == 1 ? '1er décile'|trans : '%n%e décile'|trans({'%n%': rank.decile}) }} · {{ 'médiane des ménages : %amount%'|trans({'%amount%': wealth_quantiles[50]|money_rounded}) }}</p>
    {#- Scale from 0 to 100 % of households: a tick per decile, median marked, marker at your position. -#}
    <svg class="wealth-rank-scale" viewBox="0 0 200 24" role="img" aria-label="{{ 'Échelle des ménages, des moins dotés aux mieux dotés : votre place est à environ %share%.'|trans({'%share%': rank.percent|percent(0)}) }}">
        <rect class="wealth-rank-track" x="4" y="9" width="192" height="6" rx="3"/>
        <rect class="wealth-rank-fill" x="4" y="9" width="{{ (rank.percentile * 1.92)|round(1) }}" height="6" rx="3"/>
        {% for decile in 1..9 %}
        <line class="wealth-rank-tick{{ decile == 5 ? ' is-median' }}" x1="{{ (4 + decile * 19.2)|round(1) }}" y1="{{ decile == 5 ? 4 : 7 }}" x2="{{ (4 + decile * 19.2)|round(1) }}" y2="{{ decile == 5 ? 20 : 17 }}"/>
        {% endfor %}
        <circle class="wealth-rank-marker" cx="{{ (4 + rank.percentile * 1.92)|round(1) }}" cy="12" r="6"/>
    </svg>
    <p class="wealth-rank-ends muted small" aria-hidden="true"><span>{{ 'moins dotés'|trans }}</span><span>{{ 'médiane'|trans }}</span><span>{{ 'mieux dotés'|trans }}</span></p>
    <details class="wealth-rank-details">
        <summary>{{ 'Repères et source'|trans }}</summary>
        <table class="wealth-rank-table">
            <caption class="visually-hidden">{{ 'Patrimoine net des ménages, %date%'|trans({'%date%': wealth_reference|trans}) }}</caption>
            <thead><tr><th scope="col">{{ 'Ménages'|trans }}</th><th scope="col">{{ 'Patrimoine net inférieur à'|trans }}</th></tr></thead>
            <tbody>
                {% for percent, cents in wealth_quantiles %}
                <tr><td>{{ percent|percent(0) }}</td><td class="num">{{ cents|money_rounded }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
        <p class="muted small">{{ 'Patrimoine net des ménages (logement, placements, biens professionnels, crédits déduits), hors biens durables, objets de valeur et droits à la retraite, %date%. Les seuils publiés sont reliés en ligne droite : votre place est une estimation. Si vous ne suivez que votre part et non le patrimoine de tout votre ménage, elle est sous-estimée.'|trans({'%date%': wealth_reference|trans}) }}</p>
        <p class="muted small">{{ 'Source :'|trans }} <a href="{{ wealth_source_url }}" rel="noopener noreferrer external">{{ wealth_source|trans }}</a>.</p>
    </details>
</section>
