{% extends 'base.html.twig' %}

{% block title %}{{ 'Nouveau mot de passe'|trans }}{% endblock %}

{% block body %}
<section class="card setup-card">
    <h1>{{ 'Nouveau mot de passe'|trans }}</h1>
    {% if error %}
    <p class="flash flash-error" role="alert">{{ error|trans }}</p>
    {% endif %}
    <form method="post" action="{{ path('app_password_reset_submit', {token: token}) }}" class="form">
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        <div class="field">
            <label for="password">{{ 'Nouveau mot de passe'|trans }}</label>
            <input type="password" id="password" name="password" autocomplete="new-password" minlength="{{ min_length }}" required aria-describedby="password-meter">
        </div>
        <div class="field">
            <label for="password_confirmation">{{ 'Confirmation'|trans }}</label>
            <input type="password" id="password_confirmation" name="password_confirmation" autocomplete="new-password" required>
            {{ include('_password_meter.html.twig', {input_id: 'password', confirm_id: 'password_confirmation', min_length: min_length}) }}
        </div>
        <div class="field">
            <label for="recovery_key">{{ 'Clé de récupération'|trans }}</label>
            <input type="text" id="recovery_key" name="recovery_key" autocomplete="off" aria-describedby="recovery-hint">
            <p class="hint" id="recovery-hint">{{ 'Avec elle, vos données sont conservées. Sans elle, elles ne peuvent pas être déchiffrées.'|trans }}</p>
        </div>
        <div class="field">
            <label for="code">{{ 'Code de l\'application d\'authentification ou code de secours'|trans }}</label>
            <input type="text" id="code" name="code" autocomplete="one-time-code" maxlength="20" aria-describedby="code-hint">
            <p class="hint" id="code-hint">{{ 'Obligatoire sans clé de récupération. Avec la clé mais sans code, votre application d\'authentification sera à reconfigurer.'|trans }}</p>
        </div>
        <div class="field checkbox-field">
            <input type="checkbox" id="accept_data_loss" name="accept_data_loss" value="1">
            <label for="accept_data_loss">{{ 'Je n\'ai pas de clé de récupération : j\'accepte la perte définitive de toutes mes données.'|trans }}</label>
        </div>
        <button type="submit" class="btn btn-primary btn-block">{{ 'Changer le mot de passe'|trans }}</button>
    </form>
</section>
{% endblock %}
