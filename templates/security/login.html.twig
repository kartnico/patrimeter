{% extends 'base.html.twig' %}

{% block title %}{{ 'Connexion'|trans }}{% endblock %}

{% block scripts %}<script src="{{ asset('js/webauthn.js') }}" defer></script>{% endblock %}

{% block body %}
<section class="card login-card">
    <h1>{{ 'Connexion'|trans }}</h1>
    {% if error %}
    <p class="flash flash-error" role="alert">{{ error|trans }}</p>
    {% endif %}
    <form method="post" action="{{ path('app_login') }}" class="form">
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        <label for="email">{{ 'Adresse e-mail'|trans }}</label>
        <input type="email" id="email" name="email" value="{{ last_email }}" autocomplete="username" maxlength="254" required{% if not last_email %} autofocus{% endif %}>
        <label for="password">{{ 'Mot de passe'|trans }}</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required{% if last_email %} autofocus{% endif %}>
        <button type="submit" class="btn btn-primary btn-block">{{ 'Se connecter'|trans }}</button>
    </form>
    <p class="login-alt"><a href="{{ path('app_password_forgot') }}">{{ 'Mot de passe oublié ?'|trans }}</a></p>
    <form method="post" action="{{ path('app_passkey_login') }}" class="form webauthn-form" data-webauthn="authenticate" data-webauthn-options="{{ path('app_passkey_login_options') }}" data-webauthn-field="credential" data-webauthn-prf hidden>
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        <input type="hidden" name="credential">
        <input type="hidden" name="prf_output">
        <button type="submit" class="btn btn-block">{{ 'Se connecter avec une passkey (FIDO2)'|trans }}</button>
        <p class="field-error" data-webauthn-error hidden>{{ 'La passkey (FIDO2) n\'a pas abouti. Réessayez ou utilisez votre mot de passe.'|trans }}</p>
    </form>
    {% if registration_open %}
    <p class="login-alt">{{ 'Pas encore de compte ?'|trans }} <a href="{{ path('app_register') }}">{{ 'Créer un compte'|trans }}</a></p>
    {% endif %}
    {% if documentation_on_login() %}
    <p class="login-alt"><a href="{{ documentation_url() }}" rel="help">{{ 'Documentation d\'utilisation'|trans }}</a></p>
    {% endif %}
</section>
{%- set demo_lifetime = demo_minutes() -%}
{% if demo_lifetime is not null %}
<section class="card login-card demo-offer" aria-labelledby="demo-title">
    <h2 id="demo-title">{{ 'Découvrir Patrimeter'|trans }}</h2>
    <p>{{ 'Essayez-le dans un compte de démonstration, sans inscription : des données fictives, supprimées au bout de %minutes% minutes ou à la déconnexion. N\'y saisissez aucune donnée réelle.'|trans({'%minutes%': demo_lifetime}) }}</p>
    <form method="post" action="{{ path('app_demo_start') }}">
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        <button type="submit" class="btn btn-block">{{ 'Essayer la démo'|trans }}</button>
    </form>
</section>
{% endif %}
{% endblock %}
