{#- Second factor (scheb/2fa-bundle): code of the authenticator app or backup code. -#}
{% extends 'base.html.twig' %}

{%- set messages = {
    'code_invalid': 'Code incorrect.'|trans,
    'code_reused': 'Ce code vient d\'être utilisé : attendez le suivant.'|trans,
    'Invalid CSRF token.': 'Le formulaire a expiré. Veuillez réessayer.'|trans,
} -%}

{% block title %}{{ 'Code de vérification'|trans }}{% endblock %}

{% block scripts %}<script src="{{ asset('js/webauthn.js') }}" defer></script>{% endblock %}

{% block body %}
<section class="card login-card">
    <h1>{{ 'Code de vérification'|trans }}</h1>
    {% if authenticationError %}
    <p class="flash flash-error" role="alert">{{ messages[authenticationError] ?? authenticationError|trans }}</p>
    {% endif %}
    <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" class="form">
        <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        <label for="code">{{ 'Code à 6 chiffres de votre application d\'authentification'|trans }}</label>
        <input type="text" id="code" name="{{ authCodeParameterName }}" autocomplete="one-time-code" inputmode="text"
               maxlength="20" required autofocus aria-describedby="code-hint">
        <p class="hint" id="code-hint">{{ 'Téléphone indisponible ? Saisissez l\'un de vos codes de secours (format XXXXX-XXXXX).'|trans }}</p>
        {#- Trusted browser (TrustedBrowsers): the code is not asked again here for a while. -#}
        <div class="field checkbox-field">
            <input type="checkbox" id="trust-browser" name="{{ constant('Patrimeter\\Security\\TwoFactor\\TrustedBrowsers::FIELD') }}" value="1" aria-describedby="trust-browser-hint">
            <label for="trust-browser">{{ 'Faire confiance à ce navigateur pendant %days% jours'|trans({'%days%': constant('Patrimeter\\Security\\TwoFactor\\TrustedBrowsers::DAYS')}) }}</label>
        </div>
        <p class="hint" id="trust-browser-hint">{{ 'Le code ne sera plus demandé ici, le mot de passe si. À laisser décoché sur un ordinateur partagé.'|trans }}</p>
        <button type="submit" class="btn btn-primary btn-block">{{ 'Valider'|trans }}</button>
    </form>
    {% if has_security_key() %}
    <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute) }}" class="form webauthn-form" data-webauthn="authenticate" data-webauthn-options="{{ path('app_2fa_key_options') }}" data-webauthn-field="{{ authCodeParameterName }}" hidden>
        <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        <input type="hidden" name="{{ authCodeParameterName }}">
        {#- Copy of the "trust this browser" box of the code form above (app.js). -#}
        <input type="hidden" name="{{ constant('Patrimeter\\Security\\TwoFactor\\TrustedBrowsers::FIELD') }}" value="" data-trust-copy="trust-browser">
        <button type="submit" class="btn btn-block">{{ 'Utiliser ma clé de sécurité'|trans }}</button>
        <p class="field-error" data-webauthn-error hidden>{{ 'La clé n\'a pas abouti. Réessayez ou saisissez un code.'|trans }}</p>
    </form>
    {% endif %}
    <form method="post" action="{{ logoutPath }}" class="login-alt">
        <input type="hidden" name="_csrf" value="{{ csrf_token('patrimeter') }}">
        <button type="submit" class="btn-link">{{ 'Annuler et revenir à la connexion'|trans }}</button>
    </form>
</section>
{% endblock %}
