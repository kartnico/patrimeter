{#-
    Tag of a recommendation: icon and word ("Alerte", "Attention", "À noter", "Bon point"), so that colour never
    carries the information alone. Usage: {% import '_advice.html.twig' as advice_ui %} then
    advice_ui.tag('warning').
-#}
{%- macro tag(severity) -%}
<span class="advice-tag">
    {%- if severity == 'alert' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 21h20zM12 10v5M12 18v.5"/></svg>{{ 'Alerte'|trans }}
    {%- elseif severity == 'warning' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v6M12 16v.5"/></svg>{{ 'Attention'|trans }}
    {%- elseif severity == 'ok' -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM8 12.5l3 3 5-6"/></svg>{{ 'Bon point'|trans }}
    {%- else -%}
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 11v6M12 7.5V8"/></svg>{{ 'À noter'|trans }}
    {%- endif -%}
</span>
{%- endmacro -%}
