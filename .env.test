# Test environment only.
KERNEL_CLASS='Patrimeter\Kernel'
APP_SECRET=test-only-not-a-secret
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.sqlite"
# Test key (32 zero bytes): refused in production by AuthSecrets.
AUTH_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
DEFAULT_URI=http://localhost
# Demonstration mode on (off by default): the tests exercise it.
DEMO_MODE=true
# API and MCP enabled: the tests exercise them (ApiAvailabilityTest disables them).
API_ENABLED=true
MCP_ENABLED=true
MCP_ALLOWED_ORIGINS=https://agent.example.test,http://127.0.0.1:6274
