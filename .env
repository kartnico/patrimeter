# Default values, without any secret. Never put a secret in a versioned file: override them in
# .env.local (ignored by git) or with real environment variables.
# Commented list of all the variables: .env.example

APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
APP_TIMEZONE=Europe/Paris

# SQLite database (single file, outside the web root).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/patrimeter.sqlite"

# Name of the session cookie. Over HTTPS, prefer "__Host-patrimeter" (see docs/installation.md).
SESSION_COOKIE_NAME=patrimeter

# Trusted reverse proxies (IPs or ranges, separated by commas), empty by default.
TRUSTED_PROXIES=

# Public address of the site: base of the links sent by email (never deduced from the request).
DEFAULT_URI=http://localhost:8000

# Server key of the TOTP secrets and backup codes: 32 bytes in base64, to set in .env.local
# (see .env.example). Empty here: the application refuses to start without it.
AUTH_SECRET_KEY=
# Old key, during a rotation only (docs/installation.md, § 12.5).
AUTH_SECRET_KEY_PREVIOUS=

# Registration: open (true) or not (false), and allowed email domains (separated by commas, empty = all).
REGISTRATION_ENABLED=true
REGISTRATION_ALLOWED_DOMAINS=

# Demonstration mode: "Try the demo" button on the sign-in page, temporary accounts with example data (false by
# default; true on an instance shown to visitors).
DEMO_MODE=false

# Challenges and stars ("Défis" page, first-steps card, stars announced after the monthly entry): true by default; false
# hides them for every user of the instance (each user can also turn them off).
GAMIFICATION=true

# User documentation: address of the site (one folder per language, fr/ and en/; empty: no link), and its link on the
# sign-in page (true by default).
DOCUMENTATION_URL=https://kartnico.github.io/patrimeter/
DOCUMENTATION_ON_LOGIN=true

# REST API and MCP service: true to enable each (false by default; docs/api.md).
API_ENABLED=false
MCP_ENABLED=false
# Origins (scheme://host[:port]) of web pages allowed to call the MCP service besides the site itself, separated by
# commas without spaces; empty: only the site. A client outside a browser sends no Origin header and is not concerned.
MCP_ALLOWED_ORIGINS=

# Patrimeter version at the bottom of the pages: false to hide it (true by default).
SHOW_VERSION=true

# Carbure: hosts of the instances users may link, separated by commas (empty = all).
CARBURE_ALLOWED_HOSTS=

# Daily check for the latest version (empty: disabled, no outgoing call); token: read_api, for a private project.
UPDATE_CHECK_URL=
UPDATE_CHECK_TOKEN=

# Sending emails (SMTP_HOST empty: no sending). SMTP_ENCRYPTION: starttls, tls or none.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=starttls
MAIL_FROM="Patrimeter <patrimeter@localhost>"
# Recipient of the alerts: critical errors, backup failure.
ADMIN_EMAIL=root@localhost
