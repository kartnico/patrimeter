# Patrimeter — all the environment variables, commented.
#
# Never version a secret. On a server, copy the useful lines into .env.local (ignored by git,
# readable only by root and www-data) or set them as real environment variables. Order of
# priority: environment > .env.local > .env.$APP_ENV > .env

# Environment: "prod" on a server, "dev" to develop, "test" for the tests.
APP_ENV=prod

# Random secret of the application (required). Generate it once, then never change it:
#   openssl rand -hex 32
APP_SECRET=

# Debug mode (detailed error bar): never in production. Default: 1 outside "prod".
#APP_DEBUG=0

# Time zone used to determine the current month and today's date.
APP_TIMEZONE=Europe/Paris

# SQLite database (single file outside the web root). %kernel.project_dir% = project folder.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/patrimeter.sqlite"

# Name of the session cookie. Over HTTPS, use "__Host-patrimeter": the browser then refuses the
# cookie when it is set without HTTPS or for another domain.
SESSION_COOKIE_NAME=patrimeter

# Trusted reverse proxies in front of nginx (addresses or ranges, separated by commas); empty if
# nginx receives the browsers directly. Required behind a proxy that terminates TLS: without it, the
# application does not see HTTPS and the __Host- cookie is refused (docs/installation.md, § 8.1).
TRUSTED_PROXIES=

# Public address of the site (required in production): base of the links sent by email (registration
# confirmation) and of the links generated by the commands. Never deduced from the request: a forged
# Host header cannot divert a link.
DEFAULT_URI=https://patrimeter.example.org

# Server key of the authentication secrets (required): encrypts the TOTP secrets and protects the
# hashes of the backup codes. 32 bytes in base64, to generate once:
#   openssl rand -base64 32
# Keep it safe: if it is lost, no TOTP works any more (each user will have to be reset with
# "bin/console app:user:reset-2fa"). To change it without losing anything: rotation,
# docs/installation.md § 12.5.
AUTH_SECRET_KEY=
# Old key, set only during a rotation (§ 12.5): still decrypts the secrets and checks the backup codes
# issued before the rotation.
AUTH_SECRET_KEY_PREVIOUS=

# Registration from the sign-in page: true (open) or false (closed; accounts are then created with
# « bin/console app:user:create »).
REGISTRATION_ENABLED=true
# Email domains allowed to register, separated by commas (empty: all).
REGISTRATION_ALLOWED_DOMAINS=

# Demonstration mode: true shows a « Try the demo » button on the sign-in page, which opens a temporary account
# filled with example data, without registration, password or TOTP, deleted after 2 hours or at sign-out
# (docs/reglages.md). false by default; true on an instance shown to visitors.
DEMO_MODE=false

# User documentation: address of the site, with a fr/ and an en/ folder (empty: no link in the application), linked
# from the account menu; and its link on the sign-in page (false to remove it).
DOCUMENTATION_URL=https://kartnico.github.io/patrimeter/
DOCUMENTATION_ON_LOGIN=true

# REST API and MCP service (docs/api.md): disabled by default; true to enable each. The OAuth server and the
# personal tokens only exist when one of them is enabled.
API_ENABLED=false
MCP_ENABLED=false
# Origins (scheme://host[:port]) of web pages allowed to call the MCP service besides the site itself, separated by
# commas without spaces; empty: only the site. A client outside a browser sends no Origin header and is not concerned.
MCP_ALLOWED_ORIGINS=

# Patrimeter version shown at the bottom of every page, sign-in page included: false to hide it from visitors
# (true by default).
SHOW_VERSION=true

# Carbure (actual spending against the budget): each user links their own instance. Allowed hosts, separated by
# commas (empty: all, local network included). On an instance open to the public, set them.
CARBURE_ALLOWED_HOSTS=

# Daily check for the latest published version, reported by email to ADMIN_EMAIL and in /sante (docs/supervision.md).
# Disabled while UPDATE_CHECK_URL is empty: Patrimeter then calls nothing outside. The address is the GitLab API of the
# latest Release, for instance https://gitlab.example.org/api/v4/projects/56/releases/permalink/latest; for a
# private project, UPDATE_CHECK_TOKEN is an access token with the read_api scope (Reporter role).
UPDATE_CHECK_URL=
UPDATE_CHECK_TOKEN=

# Sending emails (registration confirmation, security alerts). SMTP_HOST empty: no sending.
# SMTP_ENCRYPTION: starttls (default, port 587), tls (port 465) or none (local relay).
# No encoding to do: the special characters of the password are handled.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=starttls
# Sender of the messages.
MAIL_FROM="Patrimeter <patrimeter@example.org>"
# Recipient of the alerts: critical error of the application (500 page), backup failure. The same error is only
# reported once per hour.
ADMIN_EMAIL=
