{
  "name": "patrimeter-tests",
  "private": true,
  "license": "MIT",
  "description": "Outils de Patrimeter côté Node : lint du JavaScript et du CSS, tests unitaires et de bout en bout, accessibilité (Node ne sert jamais en production).",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
