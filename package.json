  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.11.0",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.10.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "re2js": "2.10.0"
  }
}
