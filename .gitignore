# Data and files produced at run time (SQLite database, sessions, cache, logs)
/var/*
!/var/.gitkeep

# Composer dependencies
/vendor/

# Local configuration and secrets (never versioned)
/.env.local
/.env.local.php
/.env.*.local
/config/secrets/prod/prod.decrypt.private.php

# Files generated by Symfony
/config/reference.php
/public/assets/
/public/bundles/

# Outils
/phpunit.xml
/.phpunit.cache/
/.php-cs-fixer.php
/.php-cs-fixer.cache
/.idea/
/.vscode/
*.swp
/.cache/
/node_modules/
/test-results/
/.sonar/
/playwright-report/
/reports/
# Container image built by the CI (container-image job)
/image/
# Configuration of the container deployment (secrets): docker/patrimeter.env.example is its template
/patrimeter.env
/docker/patrimeter.env
